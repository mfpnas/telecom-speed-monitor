# Stage 1: Compilação do librespeed-cli
FROM golang:1.22-alpine AS builder
WORKDIR /src
RUN CGO_ENABLED=0 go install github.com/librespeed/speedtest-cli@latest
# O binário estará em /go/bin/speedtest-cli

# Stage 2: Runtime do coletor
FROM python:3.11-slim

# Cria usuário não-root
RUN groupadd -g 1000 appuser && \
    useradd -m -u 1000 -g appuser appuser

# Instala dependências do sistema (inclui Chromium para o fast-cli)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    iperf3 \
    chromium \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Instala Node.js 22 + npm (necessário para o fast-cli)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs npm && \
    rm -rf /var/lib/apt/lists/*

# Instala dependências Python
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Instala speedtest-cli (Ookla)
RUN pip install speedtest-cli

# Instala fast-cli globalmente, sem baixar Chrome (usa o Chromium do sistema)
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
RUN npm install -g fast-cli

# Copia o binário compilado do librespeed-cli do estágio 1
COPY --from=builder /go/bin/speedtest-cli /usr/local/bin/librespeed-cli
RUN chmod +x /usr/local/bin/librespeed-cli

# Copia o código do coletor e scripts
COPY collector/ ./collector/
COPY scripts/ ./scripts/

# Ajusta permissões para o usuário appuser
RUN chown -R appuser:appuser /app

USER appuser

# Comando de entrada
CMD ["python", "-m", "collector.main"]