# Dockerfile.collector
FROM python:3.11-slim

# Cria um usuário não-root
RUN groupadd -g 1000 appuser && \
    useradd -m -u 1000 -g appuser appuser

# Instala dependências do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    npm \
    iperf3 \
    chromium \
    && rm -rf /var/lib/apt/lists/*

# Instala speedtest-cli (Ookla) via pip
RUN pip install speedtest-cli

# Instala fast-cli via npm
RUN npm install -g fast-cli

# Baixa e instala o binário librespeed-cli (versão amd64 mais recente)
RUN curl -L --fail --retry 3 -o /tmp/librespeed-cli.tar.gz \
    https://github.com/librespeed/speedtest-cli/releases/latest/download/librespeed-cli_linux_amd64.tar.gz && \
    tar xzf /tmp/librespeed-cli.tar.gz -C /usr/local/bin && \
    chmod +x /usr/local/bin/librespeed-cli && \
    rm /tmp/librespeed-cli.tar.gz

# --- INSTALA CHROME PARA O PUPPETEER (fast-cli) ---
# Cria o diretório de cache e concede permissão ao usuário appuser
RUN mkdir -p /home/appuser/.cache/puppeteer && \
    chown -R appuser:appuser /home/appuser/.cache/puppeteer

# Executa o download do Chrome como appuser
USER appuser
RUN npx --yes puppeteer browsers install chrome

# Volta para o usuário root para continuar as configurações
USER root

# Define o diretório de trabalho
WORKDIR /app

# Copia os requisitos e instala dependências Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia o código do coletor e dos scripts
COPY collector/ ./collector/
COPY scripts/ ./scripts/

# Ajusta permissões para o usuário appuser
RUN mkdir -p /app && chown -R appuser:appuser /app

# Muda para o usuário appuser (execução final)
USER appuser

# Comando de entrada
CMD ["python", "-m", "collector.main"]