# Dockerfile.collector
FROM python:3.11-slim

# Cria usuário não-root
RUN groupadd -g 1000 appuser && \
    useradd -m -u 1000 -g appuser appuser

# Instala dependências do sistema (sem chromium, pois o Chrome é baixado pelo Puppeteer)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    npm \
    iperf3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Instala dependências Python do coletor (apenas as necessárias)
COPY requirements.collector.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements.collector.txt

# Instala speedtest-cli (Ookla)
RUN pip install speedtest-cli

# Instala fast-cli via npm
RUN npm install -g fast-cli

# Compila e instala librespeed-cli via Go (sem dependências de download externas)
RUN apt-get update && apt-get install -y golang && \
    GO111MODULE=on go install github.com/librespeed/speedtest-cli@latest && \
    cp /root/go/bin/speedtest-cli /usr/local/bin/librespeed-cli && \
    chmod +x /usr/local/bin/librespeed-cli && \
    apt-get remove -y golang && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Instala Chrome para o Puppeteer (necessário para fast-cli)
RUN mkdir -p /home/appuser/.cache/puppeteer && \
    chown -R appuser:appuser /home/appuser/.cache/puppeteer

USER appuser
RUN npx --yes puppeteer browsers install chrome

USER root

WORKDIR /app
COPY collector/ ./collector/
COPY scripts/ ./scripts/

RUN chown -R appuser:appuser /app
USER appuser

CMD ["python", "-m", "collector.main"]