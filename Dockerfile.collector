# Dockerfile.collector
FROM python:3.11-slim

# Cria um usuário não-root
RUN groupadd -g 1000 appuser && \
    useradd -m -u 1000 -g appuser appuser

# Instala dependências do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    npm \
    iperf3 \
    chromium \
    && rm -rf /var/lib/apt/lists/*

# Instala speedtest-cli (Ookla) via pip
RUN pip install speedtest-cli

# Instala fast-cli via npm
RUN npm install -g fast-cli

# Baixa e instala o binário librespeed-cli (oficial) a partir do GitHub
# Usa wget com pipe para evitar problemas com arquivo temporário
RUN wget -qO- https://github.com/librespeed/speedtest-cli/releases/download/v1.0.11/librespeed-cli_linux_amd64.tar.gz | tar xz -C /usr/local/bin && \
    chmod +x /usr/local/bin/librespeed-cli

# Define o diretório de trabalho
WORKDIR /app

# Copia os requisitos e instala dependências Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia o código do coletor e dos scripts
COPY collector/ ./collector/
COPY scripts/ ./scripts/

# Ajusta permissões para o usuário appuser
RUN mkdir -p /app && chown -R appuser:appuser /app

# Muda para o usuário appuser
USER appuser

# Comando de entrada
CMD ["python", "-m", "collector.main"]