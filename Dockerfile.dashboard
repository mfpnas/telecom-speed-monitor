# Dockerfile.dashboard
FROM python:3.11-slim

WORKDIR /app

# Instala dependências do sistema necessárias
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copia os requisitos e instala as dependências Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia os módulos do projeto
COPY dashboard/ /app/dashboard/
COPY report/ /app/report/
COPY scripts/ /app/scripts/

# --- LINHA IMPORTANTE ADICIONADA ABAIXO ---
COPY generate_pdf_report.py /app/generate_pdf_report.py
# ------------------------------------------

# Copia o wrapper principal do streamlit
COPY app.py /app/app.py

# Expõe a porta do Streamlit
EXPOSE 8501

# Comando para iniciar o dashboard
CMD ["streamlit", "run", "app.py"]